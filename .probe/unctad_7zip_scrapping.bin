<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><meta http-equiv="X-UA-Compatible" content="IE=edge"><title>Error | UNCTAD Data Hub</title><meta name="description" content="UNCTADstat error"><meta name="author" content="UNCTAD"><meta name="copyright" content="United Nations"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="robots" content="index, follow"><link rel="icon" href="/sites/unctadstat/themes/custom/unctadstat/favicon.ico" type="image/vnd.microsoft.icon"><link rel="home" href="/EN/Index.html"><link rel="license" href="https://www.un.org/en/about-us/copyright"><link rel="author" href="https://unctad.org/"><link rel="alternate" hreflang="fr" href="/FR/404.html"/><link rel="stylesheet" media="all" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"><link rel="stylesheet" type="text/css" href="/css/base.css"><script src="https://code.jquery.com/jquery-3.3.1.min.js" integrity="sha256-FgpCb/KJQlLNfOu91ta32o/NMZxltwRo8QtmkMRdAu8=" crossorigin="anonymous"></script><script type="text/javascript" src="/js/base.js"></script><script type="text/javascript">
  function redirectBasedOnURL() {
      var currentURL = window.location.href;

      var redirects = {
			'/en/classifications.html':'/EN/Classifications.html',
         '/en/': '/EN/',
         '/countryprofile/en-gb/': '/CountryProfile/en-GB/',
			'/countryprofile/fr-fr/': '/CountryProfile/fr-FR/',                            
			'/countryprofile/generalprofile/en-gb/': '/CountryProfile/GeneralProfile/en-GB/',
         '/countryprofile/generalprofile/fr-fr/': '/CountryProfile/GeneralProfile/fr-FR/',
         '/countryprofile/maritimeprofile/en-gb/': '/CountryProfile/MaritimeProfile/en-GB/',
         '/countryprofile/maritimeprofile/fr-fr/': '/CountryProfile/MaritimeProfile/fr-FR/',
			'/countryprofile/': '/CountryProfile/'              
      };

      for (var path in redirects) {
          if (currentURL.includes(path.toLowerCase())) {
              var newURL = currentURL.replace(path, redirects[path]);
              window.location.href = newURL;
              return;
          }
      }
  }
  redirectBasedOnURL();
</script><script type="text/javascript">
function getSubmenuPosition(position, elements) {
	var options = {of: elements.target.element};
	if (elements.element.element.parent().parent().attr("id") === "unctadStatMainMenu") {
		options.my = "left top";
		options.at = "left bottom";
	} else {
		options.my = "left top";
		options.at = "right top";
	}
	elements.element.element.position(options);
}
$(document).ready(function () {
	$("#unctadStatMainMenu").menu({
		position: { using: getSubmenuPosition },
		icons: { submenu: "ui-icon-blank" },
		create: function (event, ui) {
			$(this).hover(
				function () { return false; },
				function () { $(this).menu("collapseAll", null, true); }
			);
		}
	});

});
</script></head><body><div id="top-banner"><div id="top-banner-content"><div id="top-banner-home"><div class="arrow arrow--left"></div></div><div id="top-banner-text"><a href="https://unctad.org/" target="_blank">Main UN Trade and Development (UNCTAD) website</a></div><div id="top-banner-language"><a title="Basculer en Français" style="color:#000000;" href="/FR/404.html" hreflang="fr">Fran&ccedil;ais</a></div><div id="top-banner-language-active">English</div></div></div><div id="container"> <!-- #BeginLibraryItem "/Library/banner-en.lbi" --><div id="banner"> <a href="/EN/Index.html" alt="Go to UNCTAD Data Hub home page" title="Go to UNCTAD Data Hub home page"><img src="/EN/img/Banner.png" height="90" alt="UNCTAD banner"></a></div><!-- #EndLibraryItem --><div id="menu" class="clear"><div id="menu-left" class="menu-list dsib-menu-list" style="padding-right:0"><ul id="unctadStatMainMenu" role="menu" class="ui-menu ui-widget ui-widget-content ui-menu-horizontal"><li class="ui-menu-item"><a class="ui-menu-item-wrapper" role="menuitem" href="/EN/About.html">About</a></li><li class="ui-menu-item ui-menu-horizontal"><a role="menuitem" class="ui-menu-item-wrapper" href="/insights/">Data insights<i class="fa-solid fa-angles-right fa-xs" aria-hidden="true"></i></a><ul role="menu" style="display:none;width:100%;min-width:220px;"><li class="ui-menu-item"><a role="menuitem" class="ui-menu-item-wrapper" href="/insights/theme/94">International trade</a></li><li class="ui-menu-item"><a role="menuitem" class="ui-menu-item-wrapper" href="/insights/theme/100">Economy and finance</a></li><li class="ui-menu-item"><a role="menuitem" class="ui-menu-item-wrapper" href="/insights/theme/107">Maritime and other transport</a></li><li class="ui-menu-item"><a role="menuitem" class="ui-menu-item-wrapper" href="/insights/theme/114">Environment</a></li><li class="ui-menu-item"><a role="menuitem" class="ui-menu-item-wrapper" href="/insights/theme/119">Digital economy and tech</a></li><li class="ui-me